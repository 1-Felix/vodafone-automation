#!/bin/sh /etc/rc.common
# Cable loss detector for kmwan, see /usr/bin/wan-loss-guard.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/wan-loss-guard
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Runs right after the stop request, usually alongside the guard's own exit
# handler. It is the backstop for when that handler never runs: a guard that
# was already dead, or procd's SIGKILL 5 s after the SIGTERM.
service_stopped() {
	( . /lib/functions/kmwan.sh; restore_detect wan )
}
