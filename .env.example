ROUTER_IP=192.168.100.1
ROUTER_USER=admin
ROUTER_PASS=your_router_password
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook
# Optional per-severity channels. Any tier left unset falls back to
# DISCORD_WEBHOOK_URL above, so setting none of these keeps current behaviour.
# DISCORD_WEBHOOK_CRITICAL=https://discord.com/api/webhooks/your/critical
# DISCORD_WEBHOOK_WARN=https://discord.com/api/webhooks/your/warn
# DISCORD_WEBHOOK_LOG=https://discord.com/api/webhooks/your/log
CHECK_INTERVAL_MS=300000
# Optional: DOCSIS signal collector (default: enabled)
# COLLECTOR_ENABLED=true
# DATA_DIR=./data
# US_POWER_WARN_DBMV=51

# LTE failover monitor (Spitz Plus + CallYa via Flint secondwan)
# LTE_ENABLED=true
# FLINT_SSH_HOST=192.168.0.1
# FLINT_SSH_USER=root
# FLINT_SSH_KEY=/app/ssh/id_ed25519
# FLINT_KNOWN_HOSTS=/app/ssh/known_hosts
# LTE_IFACE=secondwan
# LTE_DEVICE=lan5
# Metering reads the Spitz's own cellular counters (the Flint's lan5 also
# carries Flint<->Spitz LAN traffic, which is not billable against the SIM).
# Defaults fall back to the FLINT_SSH_KEY / FLINT_KNOWN_HOSTS above.
# SPITZ_SSH_HOST=192.168.8.1
# SPITZ_SSH_USER=root
# SPITZ_SSH_KEY=/app/ssh/id_ed25519
# SPITZ_KNOWN_HOSTS=/app/ssh/known_hosts
# SPITZ_MODEM_IFACE=modem_2_1
# SPITZ_CELL_DEVICE=wwan0_1
# LTE_COST_PER_MB=0.03
# DASHBOARD_PORT=8799
# DASHBOARD_URL=http://192.168.0.37:8799
# DRILL_URL=https://speed.cloudflare.com/__down?bytes=2000000
# Low-balance WARN threshold. Kept under the ~5 € top-ups in use so a fresh
# top-up is not instantly "low".
# BALANCE_LOW_EUR=3
# Reserve floor: at/below this tracked balance the monitor auto-disarms the
# fallback AND takes the Spitz modem offline so nothing can drain the SIM to 0.
# Recovery: top up, set the new balance in the dashboard, re-arm.
# BALANCE_RESERVE_EUR=0.5
# Leak watchdog: background (non-failover) cellular MB per day that triggers a
# WARN; 5x this goes CRITICAL. The SIM should be near-silent on healthy cable.
# LEAK_ALERT_MB=3
# GUARD_OPEN_MINUTES=60
# GUARD_SCRIPT=/etc/firewall.lte_guard
