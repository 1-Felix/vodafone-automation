ROUTER_IP=192.168.100.1
ROUTER_USER=admin
ROUTER_PASS=your_router_password
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook
CHECK_INTERVAL_MS=300000
# Optional: DOCSIS signal collector (default: enabled)
# COLLECTOR_ENABLED=true
# DATA_DIR=./data
# US_POWER_WARN_DBMV=51

# LTE failover monitor (Spitz Plus + CallYa via Flint secondwan)
# LTE_ENABLED=true
# FLINT_SSH_HOST=192.168.0.1
# FLINT_SSH_USER=root
# FLINT_SSH_KEY=/app/ssh/id_ed25519
# FLINT_KNOWN_HOSTS=/app/ssh/known_hosts
# LTE_IFACE=secondwan
# LTE_DEVICE=lan5
# LTE_COST_PER_MB=0.03
# DASHBOARD_PORT=8799
# DASHBOARD_URL=http://192.168.0.37:8799
# DRILL_URL=https://speed.cloudflare.com/__down?bytes=2000000
# BALANCE_LOW_EUR=10
# GUARD_OPEN_MINUTES=60
# GUARD_SCRIPT=/etc/firewall.lte_guard
